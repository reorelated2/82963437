# KyleOS operating mode. DRY_RUN is the default for this build.
# LIVE does not turn on texts, email, or calls. Those switches stay false here.
SYSTEM_MODE=DRY_RUN

# Layered kill switch. A missing value stays off. This build still does not send
# when a switch is true. DRY_RUN must be the string false before a later build
# can even consider a live channel.
DRY_RUN=true
LIVE_OUTBOUND=false
SMS_ENABLED=false
EMAIL_ENABLED=false
VOICE_ENABLED=false

# External send switches. Names only. This build does not send when they are true.
LIVE_SEND=
SMS_SEND=
EMAIL_SEND=
AI_CALLING=
CALENDAR_WRITE=

# Local inquiry desk. Binds to this computer unless OPS_HOST is changed.
OPS_HOST=127.0.0.1
OPS_PORT=8787
OPS_PASSWORD=local-kyle
OPS_DB_PATH=ops/data/desk.sqlite

# Buyer-conversion ledger. Separate SQLite file. Not a second CRM and not Supabase.
KYLEOS_LEDGER=ops/data/ledger.sqlite

# Provider credential names. Leave unset. No adapter in this build reads them to send.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
QUO_API_KEY=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
GOOGLE_CALENDAR_ID=

# Older Buyer Command Center scaffold. Not used by the lead desk. Leave unset.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
